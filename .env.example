# Cloud sync + password lock (optional): copy this file to .env.local and fill it in.
# See "Cloud sync" in README.md. The URL and anon key are under Project Settings -> API in Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The email of the single user you created under Authentication -> Users
NEXT_PUBLIC_SUPABASE_LOGIN_EMAIL=
